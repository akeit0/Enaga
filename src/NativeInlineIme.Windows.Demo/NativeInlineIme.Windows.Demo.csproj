<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NativeInlineIme.Windows\NativeInlineIme.Windows.csproj" Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms Condition="'$(OS)' == 'Windows_NT'">true</UseWindowsForms>
    <EnableDefaultCompileItems Condition="'$(OS)' != 'Windows_NT'">false</EnableDefaultCompileItems>
    <OutputType Condition="'$(OS)' != 'Windows_NT'">Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
