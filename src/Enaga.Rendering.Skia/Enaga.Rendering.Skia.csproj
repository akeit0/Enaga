<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Enaga.Rendering.Skia</AssemblyName>
    <RootNamespace>Enaga.Rendering.Skia</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Enaga.Scene\Enaga.Scene.csproj" />
    <ProjectReference Include="..\Enaga.Input\Enaga.Input.csproj" />
    <ProjectReference Include="..\Enaga.Layout\Enaga.Layout.csproj" />
    <ProjectReference Include="..\Enaga.Rendering\Enaga.Rendering.csproj" />
    <ProjectReference Include="..\Enaga.React.OkojoRuntime\Enaga.React.OkojoRuntime.csproj" />
    <Reference Include="Okojo" HintPath="..\..\okojo\src\Okojo\bin\Release\net10.0\Okojo.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="Svg.Skia" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Enaga.React.OkojoRuntime</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Enaga.Windowing.Silk</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Enaga.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
