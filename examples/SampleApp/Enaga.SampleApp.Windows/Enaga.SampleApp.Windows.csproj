<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Enaga.SampleApp.Windows</AssemblyName>
    <RootNamespace>Enaga.SampleApp.Windows</RootNamespace>
    <EnableDefaultCompileItems Condition="'$(OS)' != 'Windows_NT'">false</EnableDefaultCompileItems>
    <OutputType Condition="'$(OS)' != 'Windows_NT'">Library</OutputType>
    <PublishAot Condition="'$(OS)' == 'Windows_NT'">true</PublishAot>
  </PropertyGroup>
  <PropertyGroup>
    <IsAotCompatible Condition="'$(OS)' == 'Windows_NT'">true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup Condition="'_IsPublishing ' == 'true'">
    <Content Include="sample-appsettings.json" Link="sample-appsettings.json"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'_IsPublishing ' != 'true'">
    <Content Include="..\sample-appsettings.json" Link="sample-appsettings.json"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Enaga.SampleApp.Core\Enaga.SampleApp.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Enaga.Core\Enaga.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ProjectReference Include="..\..\..\src\Enaga.Platforms.Windows\Enaga.Platforms.Windows.csproj" />
  </ItemGroup>

</Project>
