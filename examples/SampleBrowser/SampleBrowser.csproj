<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SampleBrowser</AssemblyName>
    <RootNamespace>SampleBrowser</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Enaga.Html\Enaga.Html.csproj" />
    <ProjectReference Include="..\..\src\Enaga.Html.Loader\Enaga.Html.Loader.csproj" />
    <ProjectReference Include="..\..\src\Enaga.Browser\Enaga.Browser.csproj" />
    <ProjectReference Include="..\..\src\Enaga.Core\Enaga.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ProjectReference Include="..\..\src\Enaga.Platforms.Windows\Enaga.Platforms.Windows.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <ProjectReference Include="..\..\src\Enaga.Platforms.Mac\Enaga.Platforms.Mac.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="navigation-demo.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="assets\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
