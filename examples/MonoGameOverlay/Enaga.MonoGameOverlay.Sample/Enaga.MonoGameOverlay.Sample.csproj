<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Enaga.MonoGameOverlay.Sample</AssemblyName>
    <RootNamespace>Enaga.MonoGameOverlay.Sample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Enaga.Core\Enaga.Core.csproj" />
    <ProjectReference
      Include="..\..\..\src\Enaga.Overlay.Windows\Enaga.Overlay.Windows.csproj" />
    <ProjectReference
      Include="..\..\SampleApp\Enaga.SampleApp.Core\Enaga.SampleApp.Core.csproj" />
    <Reference Include="Okojo.Annotations"
      HintPath="..\..\..\okojo\src\Okojo.Annotations\bin\Release\netstandard2.0\Okojo.Annotations.dll" />
    <Analyzer
      Include="..\..\..\okojo\src\Okojo.SourceGenerator\bin\Release\netstandard2.0\Okojo.SourceGenerator.dll" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\SampleApp\sample-appsettings.json" Link="sample-appsettings.json"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
